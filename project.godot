; Pipegram -- Godot 4.7 project
; GL Compatibility renderer: light on a GTX 750 Ti and exports cleanly to mobile.

config_version=5

[application]

config/name="Pipegram"
config/description="A pipe-laying logic puzzle: nonogram clues, one unique pipe run."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=760
window/size/viewport_height=1080
window/size/window_width_override=570
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 2D MSAA is not supported on the GLES3 (Compatibility) backend -- leave it off
anti_aliasing/quality/msaa_2d=0
textures/vram_compression/import_etc2_astc=true

[input]

ui_reset={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":true,"keycode":82,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
